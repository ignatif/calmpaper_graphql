{
  "name": "calmpaper-graphql",
  "version": "2.0.0",
  "description": "Calmpaper GraphQL API",
  "type": "module",
  "main": "src/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.js",
    "start": "node src/index.js",
    "check": "bun test && bun ./node_modules/prisma/build/index.js validate",
    "test": "bun test",
    "db:generate": "bun ./node_modules/prisma/build/index.js generate",
    "db:migrate": "bun ./node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "bun ./node_modules/prisma/build/index.js migrate dev",
    "db:push": "bun ./node_modules/prisma/build/index.js db push",
    "db:seed": "bun ./node_modules/prisma/build/index.js db seed",
    "postinstall": "bun ./node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@graphql-tools/schema": "10.0.25",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "bcryptjs": "3.0.3",
    "dotenv": "17.2.3",
    "graphql": "16.11.0",
    "graphql-yoga": "5.21.2",
    "jsonwebtoken": "9.0.3",
    "pg": "8.16.3",
    "slugify": "1.6.6"
  },
  "devDependencies": {
    "prisma": "7.9.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.0.0"
  }
}
